generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubmissionStatus {
  draft
  pending
  approved
  rejected
  sent_back
}

enum ActionType {
  approved
  rejected
  sent_back
}

model Organization {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(255)
  slug               String   @unique @db.VarChar(64)
  schoolCode         String?  @map("school_code") @db.VarChar(10)
  plan               String   @default("free") @db.VarChar(32)
  themePrimaryColor  String?  @map("theme_primary_color") @db.VarChar(16)
  logoUrl            String?  @map("logo_url") @db.VarChar(2048)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workflows   Workflow[]
  submissions Submission[]
  webhooks    WebhookRegistration[]
  apiKeys     ApiKey[]
  members     OrgMember[]

  @@index([slug])
  @@map("organizations")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  name       String    @db.VarChar(255)
  hashedKey  String    @unique @map("hashed_key") @db.VarChar(128)
  prefix     String    @db.VarChar(32)
  scopes     String[]  @db.VarChar(64)
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdBy  String    @map("created_by") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

model OrgMember {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  email           String   @db.VarChar(255)
  name            String   @db.VarChar(255)
  roles           String[] @db.VarChar(64)
  externalUserId  String?  @map("external_user_id") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([orgId])
  @@map("org_members")
}

model Workflow {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  workflowType String   @map("workflow_type") @db.VarChar(100)
  name         String   @db.VarChar(255)
  steps        Json     @db.JsonB
  active       Boolean  @default(true)
  createdBy    String   @map("created_by") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  submissions  Submission[]

  @@unique([orgId, workflowType])
  @@index([orgId])
  @@map("workflows")
}

model Submission {
  id           String           @id @default(uuid()) @db.Uuid
  orgId        String           @map("org_id") @db.Uuid
  workflowId   String           @map("workflow_id") @db.Uuid
  externalRef  String?          @map("external_ref") @db.VarChar(255)
  externalType String?          @map("external_type") @db.VarChar(100)
  payload      Json?            @db.JsonB
  status       SubmissionStatus @default(pending)
  currentStep  Int              @default(1) @map("current_step")
  submittedBy  String           @map("submitted_by") @db.VarChar(255)
  submittedAt  DateTime         @default(now()) @map("submitted_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflow     Workflow         @relation(fields: [workflowId], references: [id])
  actions      ApprovalAction[]

  @@index([orgId])
  @@index([workflowId])
  @@index([submittedBy])
  @@index([status])
  @@index([orgId, status])
  @@index([orgId, workflowId, status])
  @@map("submissions")
}

model ApprovalAction {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @map("submission_id") @db.Uuid
  stepOrder    Int        @map("step_order")
  action       ActionType
  actor        String     @db.VarChar(255)
  actorRole    String?    @map("actor_role") @db.VarChar(100)
  comments     String?    @db.Text
  actedAt      DateTime   @default(now()) @map("acted_at")

  submission Submission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
  @@map("approval_actions")
}

model WebhookRegistration {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  url       String   @db.VarChar(2048)
  events    String[] @db.VarChar(100)
  secret    String   @db.VarChar(255)
  active    Boolean  @default(true)
  createdBy String   @map("created_by") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("webhook_registrations")
}
